{
    "name": "rehla/admin",
    "description": "Rehla Admin package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/catalog": "@dev",
        "rehla/forms": "@dev",
        "rehla/travelers": "@dev",
        "rehla/documents": "@dev",
        "rehla/wallet": "@dev",
        "rehla/topups": "@dev",
        "rehla/orders": "@dev",
        "rehla/fulfillment": "@dev",
        "rehla/notifications": "@dev",
        "rehla/content": "@dev",
        "rehla/audit": "@dev",
        "rehla/reporting": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Admin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Admin\\Providers\\AdminServiceProvider"
            ]
        }
    }
}
