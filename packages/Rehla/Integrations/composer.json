{
    "name": "rehla/integrations",
    "description": "Rehla Integrations package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "rehla/core": "@dev",
        "rehla/notifications": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Integrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Integrations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Integrations\\Providers\\IntegrationsServiceProvider"
            ]
        }
    }
}
