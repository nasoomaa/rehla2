{
    "name": "rehla/travelers",
    "description": "Rehla Travelers package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/audit": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Travelers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Travelers\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Travelers\\Providers\\TravelersServiceProvider"
            ]
        }
    }
}
