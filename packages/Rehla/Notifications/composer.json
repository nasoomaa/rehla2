{
    "name": "rehla/notifications",
    "description": "Rehla Notifications package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/audit": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Notifications\\Providers\\NotificationsServiceProvider"
            ]
        }
    }
}
