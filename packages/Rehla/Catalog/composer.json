{
    "name": "rehla/catalog",
    "description": "Rehla Catalog package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "rehla/core": "@dev",
        "rehla/documents": "@dev",
        "rehla/audit": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Catalog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Catalog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Catalog\\Providers\\CatalogServiceProvider"
            ]
        }
    }
}
