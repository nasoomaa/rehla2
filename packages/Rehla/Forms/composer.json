{
    "name": "rehla/forms",
    "description": "Rehla Forms package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "rehla/core": "@dev",
        "rehla/catalog": "@dev",
        "rehla/audit": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Forms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Forms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Forms\\Providers\\FormsServiceProvider"
            ]
        }
    }
}
