{
    "name": "rehla/documents",
    "description": "Rehla Documents package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/http-foundation": "^8.0",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/audit": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Documents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Documents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Documents\\Providers\\DocumentsServiceProvider"
            ]
        }
    }
}
